<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#F3F6F4" />
            <stroke android:width="1dp" android:color="#E2EAE5" />
            <corners android:radius="18dp" />
            <padding android:left="18dp" android:top="14dp" android:right="18dp" android:bottom="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#E5F4EB" />
            <stroke android:width="1dp" android:color="@color/accent" />
            <corners android:radius="18dp" />
            <padding android:left="18dp" android:top="14dp" android:right="18dp" android:bottom="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/white" />
            <stroke android:width="1dp" android:color="@color/line" />
            <corners android:radius="18dp" />
            <padding android:left="18dp" android:top="14dp" android:right="18dp" android:bottom="14dp" />
        </shape>
    </item>
</selector>
