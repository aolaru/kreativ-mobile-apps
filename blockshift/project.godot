config_version=5

[application]
config/name="BLOCKSHIFT"
config/version="0.5.1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icons/icon.svg"
boot_splash/bg_color=Color(0.027, 0.043, 0.086, 1)
boot_splash/show_image=false

[display]
window/size/viewport_width=480
window/size/viewport_height=960
window/size/window_width_override=480
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.027, 0.043, 0.086, 1)

[input_devices]
pointing/emulate_mouse_from_touch=true

[audio]
buses/default_bus_layout="res://assets/audio/default_bus_layout.tres"
