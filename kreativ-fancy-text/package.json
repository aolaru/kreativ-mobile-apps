{
  "name": "kreativ-android",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5174 --strictPort",
    "sync": "npm run build && cap sync android",
    "apk": "npm run sync && node scripts/build-apk.mjs",
    "test": "node --test tests/*.test.mjs && playwright test",
    "bundle:release": "npm run sync && node scripts/build-release.mjs",
    "bundle:unsigned": "npm run sync && node scripts/build-release.mjs --unsigned",
    "check:release": "node scripts/check-release.mjs",
    "store:assets": "node scripts/prepare-store.mjs",
    "dev:pro": "vite --host 127.0.0.1 --port 5187 --strictPort"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/clipboard": "^8.0.0",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "8.0.3",
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/noto-sans-math": "^5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "^1.64.1",
    "pngjs": "^7.0.0",
    "vite": "8.3.5"
  }
}
